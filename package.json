{
  "name": "weblion-panel",
  "private": true,
  "description": "weblion.one Cloud Console: server management for 24fire and Proxmox",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @weblion/api --filter @weblion/web dev",
    "dev:api": "pnpm --filter @weblion/api dev",
    "dev:web": "pnpm --filter @weblion/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @weblion/api db:generate",
    "db:migrate": "pnpm --filter @weblion/api db:migrate",
    "db:seed": "pnpm --filter @weblion/api db:seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
