# weblion.one Console configuration
# Copy to .env and fill in. Never commit .env, it holds credentials.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres connection (docker compose builds DATABASE_URL from POSTGRES_PASSWORD itself)
DATABASE_URL=postgres://weblion:weblion@localhost:5432/weblion
POSTGRES_PASSWORD=

# Public URL of the panel (invite links, cookie security, origin checks, Stripe return URLs).
# Production: https://cp.weblion.cloud. In development the Vite dev server runs on 5173 and
# proxies /api to the API.
APP_URL=http://localhost:5173

# 32 random bytes, base64. Encrypts provider credentials and 2FA secrets in the database.
# Generate with: openssl rand -base64 32
# Losing or changing it means provider credentials and 2FA must be entered again.
ENCRYPTION_KEY=

# First superadmin, only used while the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@weblion.one
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=weblion Admin

# --- 24fire (Rechenzentrum DE) ------------------------------------------------
# Account API key from the 24fire control panel. Quote it, it may contain special characters.
FIRE24_API_KEY=''
FIRE24_BASE_URL=https://manage.24fire.de
FIRE24_NAME=24fire
FIRE24_COUNTRY=DE
FIRE24_CITY=Rechenzentrum DE

# --- Proxmox VE (Self-Host CH) -------------------------------------------------
PROXMOX_URL=https://pve01-zrh.weblion.cloud:2096
# Format user@realm!tokenid. A dedicated user (e.g. weblion@pve with the Administrator
# role on /) is safer than a root@pam token. With privilege separation enabled the
# token needs its own ACL entries.
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_TLS=true
PROXMOX_NAME=Proxmox Zürich
PROXMOX_COUNTRY=CH
PROXMOX_CITY=Zürich
# Optional: storage for backups created in the panel (defaults to the first backup storage)
PROXMOX_BACKUP_STORAGE=

# --- Joker.com (Domains) ---------------------------------------------------------
# DMAPI access needs a Joker.com reseller account. Create an API key on joker.com in the
# reseller account settings. A read-only key can sync and show domains but not change
# anything (DNS, name servers, transfer lock, renewal, auth code), so give the panel a key
# with full access. Instead of the key, the reseller username and password work too; when
# both are set, the key wins. Quote values that contain special characters.
JOKER_API_KEY=''
JOKER_USERNAME=
JOKER_PASSWORD=''
# Live system. Joker's test system (OT&E, separate account, no costs):
# https://dmapi.ote.joker.com/request
JOKER_BASE_URL=https://dmapi.joker.com/request
JOKER_NAME=Joker.com

# --- Cloudflare (DNS und CDN) ------------------------------------------------------
# API token, not the Global API Key: Cloudflare dashboard > My Profile > API Tokens > Create
# Token > Custom token with the permissions Zone:Zone:Edit, Zone:DNS:Edit,
# Zone:Zone Settings:Edit and Zone:Cache Purge:Purge, zone resources "Include: All zones from
# an account" (so zones created later are covered). Optional: Account:Account Settings:Read
# shows the account name in the connection test (only with CLOUDFLARE_ACCOUNT_ID).
# Zone:Zone:Read instead of Edit works too, but then the activation check and the DNS move fail.
# An account-owned token (Manage Account > API Tokens) works as well, it needs the account id.
# Cloudflare allows 1200 API requests per 5 minutes per user, shared with every other token
# and dashboard session of that user: a dedicated Cloudflare user for the console is best.
# The console keeps each connection below 1000 requests per 5 minutes.
CLOUDFLARE_API_TOKEN=
# Account id (32 hex characters, dashboard > account home > Account ID). Only needed to create
# zones (moving the DNS of a domain to Cloudflare); it also limits the zone list to that account.
# Without it the console lists every zone the token can see. Any other format stops the start.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4
# Name of the connection, used on the first start only (change it in the admin area later).
CLOUDFLARE_NAME=Cloudflare

# --- Hetzner Cloud ---------------------------------------------------------------
# API token of one Hetzner Cloud project: Hetzner Console > project > Security > API tokens >
# Generate API token, permission "Read & Write". One connection per project, add further
# projects in the admin area (Provider). The location is reported per server.
HETZNER_API_TOKEN=
HETZNER_BASE_URL=https://api.hetzner.cloud/v1
HETZNER_NAME=Hetzner Cloud

# --- Nextcloud (Cloud-Speicher) ---------------------------------------------------
# Own Nextcloud instance the panel sells accounts on (e.g. Nextcloud AIO on a VM). Address as
# users open it: https, no redirect, with the sub path if Nextcloud lives in one.
# Use a dedicated admin account for the panel (member of the "admin" group), not a personal
# one, and one of its app passwords: Personal settings > Security > Devices & sessions >
# Create new app password. Quote the app password.
# Invitations are mailed by Nextcloud itself, so configure its e-mail server as well.
# The group prefix (default "weblion-") can only be changed for providers added in the admin
# area (Provider). Setup and recommended sharing settings: docs/providers.md.
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=''
NEXTCLOUD_NAME=Nextcloud
NEXTCLOUD_COUNTRY=CH
NEXTCLOUD_CITY=Zürich

# --- Mailcow (E-Mail) -------------------------------------------------------------
# Own mailcow-dockerized instance the panel sells mail domains on. Address as the console
# reaches the API: https with a valid certificate (there is no switch to skip the check), no
# path. The connection is created when both MAILCOW_URL and MAILCOW_API_KEY are set; add further
# instances in the admin area (Provider).
# API key with read-write access: Mailcow UI as admin > System > Configuration > Access > API
# (the menu may differ by version), or API_KEY and API_ALLOW_FROM in mailcow.conf. Enter the
# console's outgoing IPv4 and IPv6 addresses in the key's allow list and do not tick "Skip IP
# check for API". Only a-z, A-Z, 0-9 and "-", at least 16 characters. A read-only key does not
# work. Quote the key.
# Failed API logins count for Mailcow's netfilter and ban the console's IP: put the console's
# IPs on Mailcow's netfilter whitelist before testing keys.
# Creating a mail domain restarts webmail (SOGo) by default and can take up to two minutes:
# allow at least 150 s read timeout for /api/v1/admin/mail/ in a reverse proxy in front of the
# console (nginx: proxy_read_timeout). Behind Cloudflare the browser gets a 524 after about
# 100 s while the console still creates the domain. Setup: docs/providers.md.
MAILCOW_URL=
MAILCOW_API_KEY=''
# Optional: public host name for MX, IMAP, SMTP and webmail when the console reaches Mailcow
# under another name (e.g. an internal address). Default: the host of MAILCOW_URL.
MAILCOW_MAIL_HOST=
# Name and location of the instance, used on the first start only (change them in the admin area).
MAILCOW_NAME=Mailcow
MAILCOW_COUNTRY=CH
MAILCOW_CITY=Zürich

# --- CloudPanel (Websites) ---------------------------------------------------------
# Own CloudPanel CE server (2.5.0 or newer, Debian or Ubuntu) the panel sells websites on.
# Recommended: a server of its own, not the one the console runs on (not enforced; if it is the
# same, put the console's site on the agent's protected list). The console logs in over SSH as
# the agent user with an ed25519 key and may only run the root wrapper weblion-clp; install it
# on the server with deploy/cloudpanel-agent/install.sh, which also limits the key to the
# console's addresses (--from) and prints the host key fingerprint. The connection is created
# when CLOUDPANEL_HOST, CLOUDPANEL_HOST_KEY and a key are set; host, port, user, key, host key
# and access host are applied again on every start (to rotate the key, change it here and
# restart). Add further servers in the admin area (Provider), which can also generate a key pair.
# This connection always offers customers PHP 8.3 and 8.4, the applications Generic, WordPress
# and WooCommerce and no Node.js, and checks DNS against the addresses the server reports: there
# are no variables for these and the admin area cannot change them here. For other choices add
# the server in the admin area instead. Setup: deploy/cloudpanel-agent/README.md and
# docs/providers.md.
# Creating a website waits up to 330 s, certificates and deletions up to 200 s: allow at least
# 360 s read timeout in a reverse proxy in front of the console (nginx: proxy_read_timeout).
CLOUDPANEL_HOST=
CLOUDPANEL_PORT=22
CLOUDPANEL_USER=weblion-agent
# The private key (unencrypted OpenSSH ed25519) as a file readable only by the console's user
# (mode 0600), or inline in quotes with "\n" for the line breaks. The inline value wins. The
# file is read on start; in Docker it must exist inside the container (mount it). An unreadable
# file skips the connection with an error in the log.
CLOUDPANEL_PRIVATE_KEY_FILE=
CLOUDPANEL_PRIVATE_KEY=
# Pinned host key: what "ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub" prints on the
# server (install.sh prints it too), e.g. SHA256:Ab3...xyz. A changed host key stops the
# connection until it is updated.
CLOUDPANEL_HOST_KEY=
# Host customers use for SFTP/SSH (with A/AAAA records), e.g. web1.weblion.cloud. Default: CLOUDPANEL_HOST.
CLOUDPANEL_ACCESS_HOST=
# Name and location of the server, used on the first start only (change them in the admin area).
CLOUDPANEL_NAME=CloudPanel
CLOUDPANEL_COUNTRY=CH
CLOUDPANEL_CITY=Zürich
# Public resolvers (comma separated) the website DNS check asks before a Let's Encrypt
# certificate is issued. The system resolver is never used, it may know internal names.
DNS_CHECK_RESOLVERS=1.1.1.1,9.9.9.9

# --- 3CX (Telefonie) ----------------------------------------------------------------
# No variables: each 3CX phone system is added in the admin area (Provider > Provider hinzufügen
# > 3CX) with the client id and API key of its own XAPI client. Setup: docs/providers.md.

# --- Jellyfin (Streaming) ----------------------------------------------------------
# Own Jellyfin instance (10.10 or newer, setup wizard finished) the console sells streaming
# accounts on. Address as users reach it, shown to them for sign-in: https, with Jellyfin's base
# URL path if set, no query; http only inside a private network. API key: Jellyfin Dashboard >
# API Keys > +, name it weblion.one (32 characters 0-9a-f). Every Jellyfin API key is a full
# administrator, so use it for the console only. Changes apply on the next restart. Further
# instances in the admin area. Setup: docs/providers.md.
JELLYFIN_URL=
JELLYFIN_API_KEY=''
# Name and location of the instance, used on the first start only (change them in the admin area).
JELLYFIN_NAME=Jellyfin
JELLYFIN_COUNTRY=CH
JELLYFIN_CITY=Zürich

# --- Uptime Kuma (Monitoring) -------------------------------------------------------
# Own Uptime Kuma 2.x instance whose monitors customers see. Address without path, e.g.
# https://status.weblion.one. API key (uk1_...): Uptime Kuma > Settings > API Keys, without
# expiry, only for weblion.one (the first key switches /metrics to keys only). Reading needs
# nothing more. Changes apply on the next restart. Further instances in the admin area.
# Setup: docs/providers.md.
UPTIMEKUMA_URL=
UPTIMEKUMA_API_KEY=''
# Optional, for customers' own monitors (management over Uptime Kuma's web UI socket, may break
# with a Kuma update): token of a management sign-in. The admin area cannot sign in a connection
# from these variables, so print the token in a checkout of this repository (not in the Docker
# image) with
#   pnpm --filter @weblion/api kuma:token -- --url https://status.weblion.one --user admin
# It asks for the password (and 2FA code) and stores nothing. The token stays valid until the
# Uptime Kuma password changes; changing the password is how to revoke it.
UPTIMEKUMA_SESSION_TOKEN=''
# Name and location of the instance, used on the first start only (change them in the admin area).
UPTIMEKUMA_NAME=Uptime Kuma
UPTIMEKUMA_COUNTRY=CH
UPTIMEKUMA_CITY=Zürich

# --- E-Mail (SMTP) --------------------------------------------------------------
# Used for invitations, invoices, payment confirmations and credit notices.
# Either set it here, or leave SMTP_HOST empty and enter it in the admin area
# (Einstellungen > E-Mail, stored encrypted). When SMTP_HOST is set, these values win
# and the admin area shows them read-only.
SMTP_HOST=
# 587 = STARTTLS (SMTP_SECURE=false), 465 = TLS from the start (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="weblion.one <noreply@weblion.one>"
SMTP_REPLY_TO=

# --- Stripe (Karte und TWINT) ------------------------------------------------------
# Secret key from the Stripe dashboard (sk_test_... to try, sk_live_... for real money).
# Webhook endpoint in Stripe: <APP_URL>/api/v1/payments/stripe/webhook with the events
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired. Its signing secret
# (whsec_...) goes into STRIPE_WEBHOOK_SECRET. TWINT must be activated in Stripe
# (Settings > Payment methods) and only works for CHF.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHODS=card,twint

# --- Zoho Books (Buchhaltung) ------------------------------------------------------
# Self Client in the Zoho API console (api-console.zoho.eu), scope ZohoBooks.fullaccess.all,
# then exchange the grant code for a refresh token once. Organization id: Zoho Books >
# Settings > Organization profile. EU accounts use the .eu URLs below.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu
ZOHO_API_URL=https://www.zohoapis.eu/books/v3
# Zoho tax ids per rate in basis points (810 = 8.1 %), e.g. 810:123456000000012345,0:123456000000067890
ZOHO_TAX_IDS=

# --- Abrechnung -------------------------------------------------------------------
# Daily job that turns due services into invoices (drafts unless auto-finalize is on).
BILLING_JOB_ENABLED=true

# --- Development helpers -------------------------------------------------------
# Simulated provider with fake servers, for UI work and tests. Keep false in production.
ENABLE_DEMO_PROVIDER=false
# A second simulated provider with Cloudflare zones (proxy, CDN, DNS move), only together with
# ENABLE_DEMO_PROVIDER. The demo provider itself also simulates Mailcow. Keep false in production.
ENABLE_DEMO_CLOUDFLARE=false
# A simulated CloudPanel server with websites and allowances, only together with
# ENABLE_DEMO_PROVIDER. Keep false in production.
ENABLE_DEMO_CLOUDPANEL=false
SYNC_INTERVAL_SECONDS=120

# Serve the built web app from the API (single container). Docker sets this.
# WEB_DIST_DIR=../web/dist
