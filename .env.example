# weblion.one Console configuration
# Copy to .env and fill in. Never commit .env, it holds credentials.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres connection (docker compose builds DATABASE_URL from POSTGRES_PASSWORD itself)
DATABASE_URL=postgres://weblion:weblion@localhost:5432/weblion
POSTGRES_PASSWORD=

# Public URL of the panel (invite links, cookie security, origin checks).
# In development the Vite dev server runs on 5173 and proxies /api to the API.
APP_URL=http://localhost:5173

# 32 random bytes, base64. Encrypts provider credentials and 2FA secrets in the database.
# Generate with: openssl rand -base64 32
# Losing or changing it means provider credentials and 2FA must be entered again.
ENCRYPTION_KEY=

# First superadmin, only used while the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@weblion.one
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=weblion Admin

# --- 24fire (Rechenzentrum DE) ------------------------------------------------
# Account API key from the 24fire control panel. Quote it, it may contain special characters.
FIRE24_API_KEY=''
FIRE24_BASE_URL=https://manage.24fire.de
FIRE24_NAME=24fire
FIRE24_COUNTRY=DE
FIRE24_CITY=Rechenzentrum DE

# --- Proxmox VE (Self-Host CH) -------------------------------------------------
PROXMOX_URL=https://pve01-zrh.weblion.cloud:2096
# Format user@realm!tokenid. A dedicated user (e.g. weblion@pve with the Administrator
# role on /) is safer than a root@pam token. With privilege separation enabled the
# token needs its own ACL entries.
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_TLS=true
PROXMOX_NAME=Proxmox Zürich
PROXMOX_COUNTRY=CH
PROXMOX_CITY=Zürich
# Optional: storage for backups created in the panel (defaults to the first backup storage)
PROXMOX_BACKUP_STORAGE=

# --- Development helpers -------------------------------------------------------
# Simulated provider with fake servers, for UI work and tests. Keep false in production.
ENABLE_DEMO_PROVIDER=false
SYNC_INTERVAL_SECONDS=120

# Serve the built web app from the API (single container). Docker sets this.
# WEB_DIST_DIR=../web/dist
