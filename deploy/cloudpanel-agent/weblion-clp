class AgentError(Exception):
    """An answer with ok: false. Codes are the closed list of the wire protocol."""

    def __init__(self, code, message, field=None, rolled_back=None, output=None):
        super().__init__(message)
        self.code = code
        self.message = message
        self.field = field
        self.rolled_back = rolled_back
        self.output = output

    def as_dict(self, redact):
        error = {"code": self.code, "message": redact(self.message)}
        if self.field:
            error["field"] = self.field
        if self.rolled_back is not None:
            error["rolledBack"] = bool(self.rolled_back)
        if self.output:
            error["output"] = redact(self.output)
        return error


