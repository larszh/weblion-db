# Validation (the console checks the same patterns; this script is the authority)


def invalid(message, field):
    return AgentError("invalid", message, field=field)


def v_domain(value, field="domain"):
    if not isinstance(value, str) or not DOMAIN_RE.fullmatch(value):
        raise invalid("Not a valid domain name (lower-case ASCII, punycode for umlauts)", field)
    return value


def v_site_user(value, agent_user, field="siteUser"):
    if not isinstance(value, str) or not SITE_USER_RE.fullmatch(value):
        raise invalid("A site user has 3 to 32 characters: a-z, 0-9 and -, starting with a letter", field)
    if value in RESERVED_USERS or value.startswith("weblion") or value == agent_user:
        raise invalid("This user name is reserved", field)
    return value


def v_type(value):
    if value in ("python", "reverse-proxy"):
        raise invalid("Python sites and reverse proxies are not created through the console", "type")
    if not isinstance(value, str) or value not in CREATABLE_TYPES:
        raise invalid("The site type must be php, static or nodejs", "type")
    return value


def v_php_version(value):
    if not isinstance(value, str) or not PHP_VERSION_RE.fullmatch(value):
        raise invalid("Not a PHP version such as 8.4", "phpVersion")
    return value


def v_template(value):
    if not isinstance(value, str) or not TEMPLATE_RE.fullmatch(value):
        raise invalid("Not a valid application template name", "template")
    return value


def v_nodejs_version(value):
    if not isinstance(value, str) or value not in NODEJS_VERSIONS:
        raise invalid("The Node.js version must be one of " + ", ".join(NODEJS_VERSIONS), "nodejsVersion")
    return value


def v_db_name(value, field, prefix=None):
    if not isinstance(value, str) or not DB_NAME_RE.fullmatch(value) or value in SYSTEM_SCHEMAS:
        raise invalid("A database name has 2 to 32 characters: a-z, 0-9 and _, starting with a letter", field)
    if prefix is not None and not value.startswith(prefix):
        raise invalid("Database names of this site start with " + prefix, field)
    return value


def v_password(value, field):
    if not isinstance(value, str) or not PASSWORD_RE.fullmatch(value):
        raise invalid("A password has 12 to 128 characters: letters, digits and !#%*+,-./;<=>?@^_{|}~", field)
    return value


def expect_keys(args, allowed, secret_values, allowed_secrets):
    for key in args:
        if key not in allowed:
            raise invalid("Unknown argument " + clip(key, 40), key[:100])
    for key in secret_values:
        if key not in allowed_secrets:
            raise invalid("Unknown secret " + clip(key, 40), key[:100])


def parse_nothing(_config, args, secret_values):
    expect_keys(args, (), secret_values, ())
    return {}


def parse_domain(_config, args, secret_values):
    expect_keys(args, ("domain",), secret_values, ())
    return {"domain": v_domain(args.get("domain"))}


def parse_password(_config, args, secret_values):
    expect_keys(args, ("domain",), secret_values, ("password",))
    return {"domain": v_domain(args.get("domain")), "password": v_password(secret_values.get("password"), "password")}


def parse_db_user(_config, args, secret_values):
    expect_keys(args, ("domain", "name", "userName"), secret_values, ("password",))
    return {
        "domain": v_domain(args.get("domain")),
        "name": v_db_name(args.get("name"), "name"),
        "userName": v_db_name(args.get("userName"), "userName"),
        "password": v_password(secret_values.get("password"), "password"),
    }


def parse_db_delete(_config, args, secret_values):
    expect_keys(args, ("domain", "name"), secret_values, ())
    return {"domain": v_domain(args.get("domain")), "name": v_db_name(args.get("name"), "name")}


def parse_create(config, args, secret_values):
    expect_keys(
        args,
        ("domain", "type", "phpVersion", "template", "nodejsVersion", "siteUser", "database"),
        secret_values,
        ("password", "databasePassword"),
    )
    out = {
        "domain": v_domain(args.get("domain")),
        "type": v_type(args.get("type")),
        "siteUser": v_site_user(args.get("siteUser"), config["agentUser"]),
        "password": v_password(secret_values.get("password"), "password"),
    }
    kind = out["type"]
    for key, needed in (
        ("phpVersion", kind == "php"),
        ("template", kind == "php"),
        ("nodejsVersion", kind == "nodejs"),
    ):
        if needed and key not in args:
            raise invalid("A %s site needs %s" % (kind, key), key)
        if not needed and key in args:
            raise invalid("%s is not used for %s sites" % (key, kind), key)
    if kind == "php":
        out["phpVersion"] = v_php_version(args["phpVersion"])
        out["template"] = v_template(args["template"])
    if kind == "nodejs":
        out["nodejsVersion"] = v_nodejs_version(args["nodejsVersion"])
    database = args.get("database")
    if database is not None:
        if not isinstance(database, dict) or set(database) != {"name", "userName"}:
            raise invalid("database needs exactly name and userName", "database")
        prefix = db_prefix(out["siteUser"])
        out["database"] = {
            "name": v_db_name(database["name"], "database", prefix),
            "userName": v_db_name(database["userName"], "database", prefix),
        }
        out["databasePassword"] = v_password(secret_values.get("databasePassword"), "databasePassword")
    elif "databasePassword" in secret_values:
        raise invalid("databasePassword is only sent with a database", "databasePassword")
    return out


