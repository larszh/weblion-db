# ---------------------------------------------------------------------------------------------
# Small helpers


def iso(timestamp):
    return datetime.datetime.fromtimestamp(timestamp, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def panel_time(value):
    """CloudPanel's "YYYY-MM-DD HH:MM:SS", read as UTC, or None."""
    if not isinstance(value, str):
        return None
    try:
        parsed = datetime.datetime.strptime(value.strip()[:19].replace("T", " "), "%Y-%m-%d %H:%M:%S")
    except ValueError:
        return None
    return parsed.replace(tzinfo=datetime.timezone.utc)


def panel_iso(value):
    parsed = panel_time(value)
    return parsed.strftime("%Y-%m-%dT%H:%M:%SZ") if parsed else None


def parse_version(value):
    """(major, minor, patch) of a Debian package version like "1:2.5.4-3+clp-noble", or None."""
    if not isinstance(value, str):
        return None
    match = re.match(r"(?:[0-9]+:)?([0-9]+)\.([0-9]+)(?:\.([0-9]+))?", value.strip())
    return tuple(int(part or 0) for part in match.groups()) if match else None


def clip(value, length):
    if value is None:
        return None
    value = str(value)
    return value[:length]


def to_int(value):
    if isinstance(value, bool):
        return None
    if isinstance(value, int):
        return value
    if isinstance(value, str) and re.fullmatch(r"[0-9]{1,18}", value.strip()):
        return int(value.strip())
    return None


def www_counterpart(domain):
    return domain[4:] if domain.startswith("www.") else "www." + domain


def db_prefix(site_user):
    """Prefix of a site's databases: site user with "-" as "_", at most 16 characters, then "_"."""
    return site_user.replace("-", "_")[:16].rstrip("_") + "_"


def sql_str(value):
    """A pattern-checked value as an SQL string literal, escaped anyway."""
    return "'" + value.replace("\\", "\\\\").replace("'", "''") + "'"


def last_line(text):
    lines = [line.strip() for line in (text or "").splitlines() if line.strip()]
    return lines[-1][:300] if lines else ""


def pem_is_lets_encrypt(pem):
    """True when the first certificate of a PEM names Let's Encrypt (its issuer), None when unreadable."""
    if not isinstance(pem, str):
        return None
    match = re.search(r"-----BEGIN CERTIFICATE-----([A-Za-z0-9+/=\s]+)-----END CERTIFICATE-----", pem)
    if not match:
        return None
    try:
        der = binascii.a2b_base64("".join(match.group(1).split()))
    except (binascii.Error, ValueError):
        return None
    return b"Let's Encrypt" in der


def parse_table(text):
    """Rows of a clpctl table ("| a | b |"), without separator lines."""
    rows = []
    for line in (text or "").splitlines():
        line = line.strip()
        if line.startswith("|") and line.endswith("|") and len(line) > 1:
            rows.append([cell.strip() for cell in line[1:-1].split("|")])
    return rows


def parse_templates(text):
    templates, seen = [], set()
    for row in parse_table(text):
        name = row[0] if row else ""
        if name == "Name" or name in seen or not TEMPLATE_RE.fullmatch(name):
            continue
        seen.add(name)
        templates.append({"name": name, "rootDirectory": row[1] if len(row) > 1 else None})
    return templates


def parse_master_credentials(text):
    """Host, User Name, Password, Port of "clpctl db:show:master-credentials". The password may
    contain "|", so each row is matched from both ends."""
    values = {}
    for line in (text or "").splitlines():
        match = re.fullmatch(r"\s*\|\s*(Host|User Name|Password|Port)\s*\|\s?(.*?)\s*\|\s*", line)
        if match:
            values[match.group(1)] = match.group(2)
    return values


